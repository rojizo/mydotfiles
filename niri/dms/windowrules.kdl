// @id=wr_1785145450997268634 @name=org.gnome.Calculator
window-rule {
    match app-id="^org.gnome.Calculator$"
    open-floating true
}

// @id=wr_1785149107908748396 @name=firefox
window-rule {
    match app-id="^firefox$"
    open-maximized true
}

// @id=wr_1785149128745468685 @name=brave-browser
window-rule {
    match app-id="^brave-browser$"
    open-maximized true
}
